Description: Allow nvidia-cdi-refresh.service without nvidia-smi
 Debian packages nvidia-smi separately from nvidia-driver, so nvidia-smi is
 not guaranteed to be installed when the NVIDIA driver is present. Remove the
 nvidia-smi path conditions and initialize the driver through nvidia-ctk
 instead of requiring nvidia-smi before generating the CDI specification.
Author: dengbo <dengbo@deepin.org>
Last-Update: 2026-09-18

This patch header follows DEP-3: http://dep.debian.net/deps/dep3/
diff --git a/deployments/systemd/nvidia-cdi-refresh.service b/deployments/systemd/nvidia-cdi-refresh.service
index 7c483c81..2a3d58d8 100644
--- a/deployments/systemd/nvidia-cdi-refresh.service
+++ b/deployments/systemd/nvidia-cdi-refresh.service
@@ -14,9 +14,6 @@
 
 [Unit]
 Description=Refresh NVIDIA CDI specification file
-ConditionPathExists=|/usr/bin/nvidia-smi
-ConditionPathExists=|/usr/sbin/nvidia-smi
-ConditionPathExists=|/usr/lib/wsl/lib/nvidia-smi
 ConditionPathExists=/usr/bin/nvidia-ctk
 # Limit the number of successive restarts to 5 in 10 seconds.
 StartLimitBurst=5
@@ -28,7 +25,10 @@ Type=oneshot
 Environment=NVIDIA_CTK_CDI_OUTPUT_FILE_PATH=/var/run/cdi/nvidia.yaml
 EnvironmentFile=-/etc/nvidia-container-toolkit/nvidia-cdi-refresh.env
 ExecCondition=/bin/sh -c '/usr/bin/grep -qE "/(nvidia|nvidia-current)[.]ko" /lib/modules/%v/modules.dep || [ -e /dev/dxg ]'
-ExecStart=/bin/sh -c '/usr/bin/nvidia-smi -L || /usr/sbin/nvidia-smi -L || /usr/lib/wsl/lib/nvidia-smi -L'
+# Load the NVIDIA kernel modules and create control device nodes before
+# generating the CDI specification. This does not require nvidia-smi, which
+# Debian packages separately from nvidia-driver.
+ExecStart=-/bin/sh -c '[ -e /dev/dxg ] || /usr/bin/grep -qE "^(nvidia|nvgpu) " /proc/modules || /usr/bin/nvidia-ctk system create-device-nodes --control-devices --load-kernel-modules || /usr/bin/nvidia-ctk system create-device-nodes --control-devices'
 ExecStart=/usr/bin/nvidia-ctk cdi generate
 CapabilityBoundingSet=CAP_SYS_MODULE CAP_SYS_ADMIN CAP_MKNOD
 # We set the service to restart on failure to ensure that a CDI spec is
